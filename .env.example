# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API). Never commit .env — it's gitignored.

# Safe to expose to the browser (Vite only bundles VITE_-prefixed vars):
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only — used by scripts/refresh-conditions.ts and scripts/import-sites.ts.
# NEVER prefix this with VITE_ (that would bundle it into client-side JS and leak it).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
